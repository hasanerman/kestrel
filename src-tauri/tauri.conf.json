{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kestrel",
  "version": "0.1.0",
  "identifier": "com.kestrel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kestrel",
        "width": 720,
        "height": 460,
        "minWidth": 620,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self' data:; script-src 'self'",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ws://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2MTI4NEQ2NzkzRDA2QjkKUldTNUJqMTUxb1FTbGxkTW5yL2FlV0o5QUNIK2xwSnAxRzlrWVgvUWd3YjFuckNmSi9nSjFOczUK",
      "endpoints": ["https://github.com/hasanerman/kestrel/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "kestrel",
    "copyright": "kestrel contributors. Licensed under GPL-3.0.",
    "category": "Utility",
    "shortDescription": "Internet connection monitor",
    "longDescription": "kestrel watches the health of your internet connection, shows which apps use the network and checks which sites you can reach.",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
